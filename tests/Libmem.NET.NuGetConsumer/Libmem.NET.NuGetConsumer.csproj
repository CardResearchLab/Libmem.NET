<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Libmem.NET.NuGetConsumer</AssemblyName>
    <RootNamespace>Libmem.NET.NuGetConsumer</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64;x86</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LibmemNetTestPackageVersion Condition="'$(LibmemNetTestPackageVersion)' == ''">0.0.0-local</LibmemNetTestPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Libmem.NET"
                      Version="$(LibmemNetTestPackageVersion)" />
  </ItemGroup>
</Project>
