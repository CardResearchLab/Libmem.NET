<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Libmem.NET.NuGetConsumer</AssemblyName>
    <RootNamespace>Libmem.NET.NuGetConsumer</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64;x86</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LibmemNetTestPackageVersion Condition="'$(LibmemNetTestPackageVersion)' == ''">0.0.0-local</LibmemNetTestPackageVersion>
    <!-- Local candidate builds explicitly opt in; released 2.4.0 consumers compile the new API checks by default. -->
    <DefineConstants Condition="'$(LibmemNetTestUnreleasedApis)' == 'true' Or '$(LibmemNetTestPackageVersion)' == '2.4.0'">$(DefineConstants);LIBMEM_NET_TEST_UNRELEASED_APIS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Libmem.NET"
                      Version="$(LibmemNetTestPackageVersion)" />
  </ItemGroup>
</Project>
