<Project>
  <PropertyGroup>
    <_LibmemNetNativeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\runtimes\win-x64\native'))</_LibmemNetNativeRoot>
  </PropertyGroup>

  <Target Name="LibmemNetValidateX64" BeforeTargets="ResolveReferences">
    <Error Condition="'$(OS)' != 'Windows_NT'"
           Text="Libmem.NET currently supports only Windows x64." />
    <Error Condition="'$(PlatformTarget)' != 'x64' and '$(Platform)' != 'x64'"
           Text="Libmem.NET currently supports only Windows x64. Set PlatformTarget or Platform to x64." />
  </Target>

  <ItemGroup>
    <ContentWithTargetPath Include="$(_LibmemNetNativeRoot)\libmem.dll">
      <TargetPath>libmem.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="$(_LibmemNetNativeRoot)\Ijwhost.dll">
      <TargetPath>Ijwhost.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>
  </ItemGroup>
</Project>
