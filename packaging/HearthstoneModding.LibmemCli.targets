<Project>
  <PropertyGroup>
    <_LibmemCliNativeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\runtimes\win-x64\native'))</_LibmemCliNativeRoot>
  </PropertyGroup>

  <Target Name="LibmemCliValidateX64" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PlatformTarget)' != 'x64' and '$(Platform)' != 'x64'"
           Text="HearthstoneModding.LibmemCli currently supports only Windows x64. Set PlatformTarget or Platform to x64." />
  </Target>

  <ItemGroup>
    <ContentWithTargetPath Include="$(_LibmemCliNativeRoot)\libmem.dll">
      <TargetPath>libmem.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="$(_LibmemCliNativeRoot)\Ijwhost.dll">
      <TargetPath>Ijwhost.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>
  </ItemGroup>
</Project>
