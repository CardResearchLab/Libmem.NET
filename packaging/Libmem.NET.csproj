<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <PackageId>Libmem.NET</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.0.0-local</PackageVersion>
    <Authors>xiaohei7972</Authors>
    <Description>Windows x64 / .NET 8 C++/CLI wrapper for rdbo/libmem, providing managed process, memory, scanning, hooking, injection, assembly, and symbol APIs.</Description>
    <PackageReleaseNotes>English: Libmem.NET 2.1.1 is a backward-compatible maintenance release. It rejects the libmem bad-address sentinel when constructing VmtManager, adds regression coverage for that managed boundary, and documents the post-2.1.0 delivery gap where GitHub v2.1.0 was published but nuget.org still exposes 2.0.0. Public API remains compatible with 2.1.0. 中文：Libmem.NET 2.1.1 是向后兼容的维护修复版本，修复 VmtManager 构造时未拒绝 libmem bad-address sentinel 的问题并补充对应回归测试，同时记录 2.1.0 发布后的交付缺口：GitHub v2.1.0 已发布，但 nuget.org 当前仍只提供 2.0.0。Public API 保持与 2.1.0 兼容。 Full notes / 完整说明: https://github.com/CardResearchLab/Libmem.NET/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/CardResearchLab/Libmem.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == ''">local</RepositoryCommit>
    <PackageProjectUrl>https://github.com/CardResearchLab/Libmem.NET</PackageProjectUrl>
    <PackageTags>libmem memory interop cpp-cli windows x64</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\artifacts\managed\x64\$(Configuration)\Libmem.NET.dll"
          Pack="true"
          PackagePath="lib\net8.0\Libmem.NET.dll" />
    <None Include="..\artifacts\managed\x64\$(Configuration)\Libmem.NET.xml"
          Pack="true"
          PackagePath="lib\net8.0\Libmem.NET.xml" />
    <None Include="..\artifacts\native\x64\$(Configuration)\bin\libmem.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\libmem.dll" />
    <None Include="..\artifacts\managed\x64\$(Configuration)\Ijwhost.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\Ijwhost.dll" />
    <None Include="Libmem.NET.targets"
          Pack="true"
          PackagePath="buildTransitive\Libmem.NET.targets" />
    <None Include="NUGET_README.md"
          Pack="true"
          PackagePath="README.md" />
    <None Include="..\LICENSE"
          Pack="true"
          PackagePath="" />
    <None Include="..\THIRD_PARTY_NOTICES.md"
          Pack="true"
          PackagePath="THIRD_PARTY_NOTICES.md" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="CHANGELOG.md" />
    <None Include="..\docs\MIGRATION.md" Pack="true" PackagePath="MIGRATION.md" />
  </ItemGroup>
</Project>
