<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>Libmem.NET</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.0.0-local</PackageVersion>
    <Authors>xiaohei7972</Authors>
    <Description>Windows x64/x86 / .NET 8 C++/CLI wrapper for rdbo/libmem, providing managed process, memory, scanning, hooking, injection, assembly, and symbol APIs.</Description>
    <PackageReleaseNotesEnglish: Libmem.NET 2.4.1 hardens ReadAlignedCode at inaccessible memory-page boundaries, adds PID plus creation-time checks for remote memory mutation, Hook installation and module load/unload, and stabilizes failed-unhook regression tests. Public APIs, pinned native libmem and Windows x64/x86 / .NET 8 support remain unchanged. Identity preflights do not eliminate the check-to-use race in native PID-only calls. 中文：Libmem.NET 2.4.1 修复 ReadAlignedCode 在不可访问内存页边界的读取问题，增强远程内存修改、Hook 安装及模块加载/卸载的 PID 与创建时间身份校验，并稳定卸载 Hook 失败路径测试。保持公共 API、固定 native libmem 和 Windows x64/x86 / .NET 8 支持不变；预检查无法彻底消除原生 PID 操作的竞态。Full notes / 完整说明: https://github.com/CardResearchLab/Libmem.NET/blob/main/docs/releases/v2.4.1.md</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/CardResearchLab/Libmem.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == ''">local</RepositoryCommit>
    <PackageProjectUrl>https://github.com/CardResearchLab/Libmem.NET</PackageProjectUrl>
    <PackageTags>libmem memory interop cpp-cli windows x64 x86</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\artifacts\package\Libmem.NET-windows-x64\Libmem.NET.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\lib\net8.0\Libmem.NET.dll" />
    <None Include="..\artifacts\package\Libmem.NET-windows-x64\Libmem.NET.xml"
          Pack="true"
          PackagePath="runtimes\win-x64\lib\net8.0\Libmem.NET.xml" />
    <None Include="..\artifacts\package\Libmem.NET-windows-x64\libmem.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\libmem.dll" />
    <None Include="..\artifacts\package\Libmem.NET-windows-x64\Ijwhost.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\Ijwhost.dll" />

    <None Include="..\artifacts\package\Libmem.NET-windows-x86\Libmem.NET.dll"
          Pack="true"
          PackagePath="runtimes\win-x86\lib\net8.0\Libmem.NET.dll" />
    <None Include="..\artifacts\package\Libmem.NET-windows-x86\Libmem.NET.xml"
          Pack="true"
          PackagePath="runtimes\win-x86\lib\net8.0\Libmem.NET.xml" />
    <None Include="..\artifacts\package\Libmem.NET-windows-x86\libmem.dll"
          Pack="true"
          PackagePath="runtimes\win-x86\native\libmem.dll" />
    <None Include="..\artifacts\package\Libmem.NET-windows-x86\Ijwhost.dll"
          Pack="true"
          PackagePath="runtimes\win-x86\native\Ijwhost.dll" />

    <None Include="Libmem.NET.targets"
          Pack="true"
          PackagePath="buildTransitive\Libmem.NET.targets" />
    <None Include="NUGET_README.md"
          Pack="true"
          PackagePath="README.md" />
    <None Include="..\LICENSE"
          Pack="true"
          PackagePath="" />
    <None Include="..\THIRD_PARTY_NOTICES.md"
          Pack="true"
          PackagePath="THIRD_PARTY_NOTICES.md" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="CHANGELOG.md" />
    <None Include="..\docs\MIGRATION.md" Pack="true" PackagePath="MIGRATION.md" />
  </ItemGroup>
</Project>
