<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <PackageId>Libmem.NET</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.0.0-local</PackageVersion>
    <Authors>xiaohei7972</Authors>
    <Description>Windows x64 / x86 .NET 8 C++/CLI wrapper for rdbo/libmem, providing managed process, memory, scanning, hooking, injection, assembly, and symbol APIs.</Description>
    <PackageReleaseNotes>English: Libmem.NET 2.1.1 is the current stable baseline. The 2.2 development line adds validated Windows x86 support while preserving the managed Public API. 中文：Libmem.NET 2.1.1 为当前稳定基线；2.2 开发线在保持托管 Public API 不变的前提下加入经过验证的 Windows x86 支持。 Full notes / 完整说明: https://github.com/CardResearchLab/Libmem.NET/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/CardResearchLab/Libmem.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == ''">local</RepositoryCommit>
    <PackageProjectUrl>https://github.com/CardResearchLab/Libmem.NET</PackageProjectUrl>
    <PackageTags>libmem memory interop cpp-cli windows x64 x86</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <LibmemNetX64ManagedRoot Condition="'$(LibmemNetX64ManagedRoot)' == ''">..\artifacts\managed\x64\$(Configuration)</LibmemNetX64ManagedRoot>
    <LibmemNetX64NativeRoot Condition="'$(LibmemNetX64NativeRoot)' == ''">..\artifacts\native\x64\$(Configuration)\bin</LibmemNetX64NativeRoot>
    <LibmemNetX86ManagedRoot Condition="'$(LibmemNetX86ManagedRoot)' == ''">..\artifacts\managed\x86\$(Configuration)</LibmemNetX86ManagedRoot>
    <LibmemNetX86NativeRoot Condition="'$(LibmemNetX86NativeRoot)' == ''">..\artifacts\native\x86\$(Configuration)\bin</LibmemNetX86NativeRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(LibmemNetX64ManagedRoot)\Libmem.NET.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\lib\net8.0\Libmem.NET.dll" />
    <None Include="$(LibmemNetX64ManagedRoot)\Libmem.NET.xml"
          Pack="true"
          PackagePath="runtimes\win-x64\lib\net8.0\Libmem.NET.xml" />
    <None Include="$(LibmemNetX64NativeRoot)\libmem.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\libmem.dll" />
    <None Include="$(LibmemNetX64ManagedRoot)\Ijwhost.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\Ijwhost.dll" />

    <None Include="$(LibmemNetX86ManagedRoot)\Libmem.NET.dll"
          Pack="true"
          PackagePath="runtimes\win-x86\lib\net8.0\Libmem.NET.dll" />
    <None Include="$(LibmemNetX86ManagedRoot)\Libmem.NET.xml"
          Pack="true"
          PackagePath="runtimes\win-x86\lib\net8.0\Libmem.NET.xml" />
    <None Include="$(LibmemNetX86NativeRoot)\libmem.dll"
          Pack="true"
          PackagePath="runtimes\win-x86\native\libmem.dll" />
    <None Include="$(LibmemNetX86ManagedRoot)\Ijwhost.dll"
          Pack="true"
          PackagePath="runtimes\win-x86\native\Ijwhost.dll" />

    <None Include="Libmem.NET.targets"
          Pack="true"
          PackagePath="buildTransitive\Libmem.NET.targets" />
    <None Include="NUGET_README.md"
          Pack="true"
          PackagePath="README.md" />
    <None Include="..\LICENSE"
          Pack="true"
          PackagePath="" />
    <None Include="..\THIRD_PARTY_NOTICES.md"
          Pack="true"
          PackagePath="THIRD_PARTY_NOTICES.md" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="CHANGELOG.md" />
    <None Include="..\docs\MIGRATION.md" Pack="true" PackagePath="MIGRATION.md" />
  </ItemGroup>
</Project>
